# ── Gmail ─────────────────────────────────────────────────
# Use an App Password, not your regular Gmail password.
# Generate one at: myaccount.google.com/security → App passwords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Nextcloud ──────────────────────────────────────────────
# Your Nextcloud instance URL (no trailing slash)
# Example: http://192.168.1.50:8080
NEXTCLOUD_URL=http://YOUR_IP:PORT
NEXTCLOUD_USER=your_nextcloud_username
NEXTCLOUD_PASSWORD=your_nextcloud_password

# CalDAV URL — usually NEXTCLOUD_URL + /remote.php/dav
NEXTCLOUD_CALDAV_URL=http://YOUR_IP:PORT/remote.php/dav

# ── Telegram ───────────────────────────────────────────────
# 1. Create a bot with @BotFather → /newbot → copy the token
# 2. Send any message to your bot, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the "id" value inside "chat"
TELEGRAM_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
